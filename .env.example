# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Opcional: precio único legacy; el checkout regional usa precios CLP/USD en código.
STRIPE_PRICE_ID=

# Simular país en local (CL, AR, …). Solo en NODE_ENV=development.
STRIPE_GEO_DEV_COUNTRY=

# App (URLs de redirección OAuth / Stripe; sin barra final)
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAILS=rayana@dominio.com

# Supabase Storage (optional; can derive from NEXT_PUBLIC_SUPABASE_URL + bucket)
NEXT_PUBLIC_SUPABASE_STORAGE_URL=

# Makeray Proveedores — Lemon Squeezy (planes vitrina/pro + webhook dedicado)
LEMON_SQUEEZY_PLAN_VITRINA_VARIANT_ID=
LEMON_SQUEEZY_PLAN_PRO_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET_PROVEEDORES=

# Edge Function badge-updater (Authorization: Bearer …)
BADGE_UPDATER_CRON_SECRET=

# Hotmart (OAuth + webhooks + checkout; ver documentación Hotmart Developers)
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
# Valor del header Authorization: con o sin prefijo "Basic "
HOTMART_BASIC_TOKEN=
HOTMART_HOTTOK=
HOTMART_PRODUCT_ID=
HOTMART_SANDBOX=true
# Opcional: mismo valor que HOTMART_* para el botón de checkout en el navegador
NEXT_PUBLIC_HOTMART_PRODUCT_ID=
NEXT_PUBLIC_HOTMART_SANDBOX=

# Playwright E2E (optional; use .env.test.local for local auth specs — see .env.test.local.example)
# E2E_EMAIL=
# E2E_PASSWORD=
